# Local ABS API origin (must match Backend/.env PORT). Next probes 5000–5010 if this port is down.
# Example: Backend PORT=5001 → ABS_API_ORIGIN=http://127.0.0.1:5001
ABS_API_ORIGIN=http://127.0.0.1:5001

# Optional: call ABS directly from the browser (triggers CORS). Prefer leaving unset
# so the app uses same-origin /api (proxied to ABS_API_ORIGIN / probed local port).
# NEXT_PUBLIC_ABS_API_URL=http://127.0.0.1:5001/api

# ABS marketing site — business signup / “For businesses” links
NEXT_PUBLIC_ABS_SITE_URL=https://absghana.com
# Optional override for the business signup CTA (defaults to ABS_SITE_URL)
# NEXT_PUBLIC_ABS_BUSINESS_SIGNUP_URL=https://absghana.com
