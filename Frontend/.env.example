# API base URL (required in production if not using ABS production domains)
# Local development should call the local backend. The backend can use the demo database via Backend/.env DATABASE_URL.
# You may explicitly set this to the demo API for debugging, but do not set the production API for localhost.
# Local: leave VITE_API_URL unset, or set http://127.0.0.1:5002 (or 5001 if Backend/.env PORT=5001).
# Do not set https://api.africanbusinesssuite.com in Frontend/.env.local for localhost — Vite ignores it and probes local ports.
# VITE_API_URL=http://127.0.0.1:5002

# Public storefront origin used by dashboard store/product links (Sabito marketplace).
# Local links should open the standalone storefront Vite app.
VITE_STOREFRONT_URL=http://localhost:3002

# ABS Online Store origin (live shop preview links on Online Store page).
# Production default when unset: https://store.absghana.com → /shop/:slug
# Do not set this to marketing www.absghana.com or Sabito sabitostore.com.
# VITE_ONLINE_STORE_URL=https://store.absghana.com

# Public template gallery origin (local: same as storefront → /templates on :3002).
# Production default when unset: https://templates.absghana.com
# VITE_TEMPLATES_GALLERY_URL=http://localhost:3002

# Google OAuth (sign-in / sign-up) – Web client ID from Google Cloud Console
# Create OAuth 2.0 Client ID (Web application), add authorized JavaScript origins (e.g. http://localhost:5173)
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Production (myapp.africanbusinesssuite.com): set to your API URL. If unset, app auto-uses https://api.africanbusinesssuite.com when served from myapp.africanbusinesssuite.com
# VITE_API_URL=https://api.africanbusinesssuite.com

# API timeout in ms (optional, default 60000)
# VITE_API_TIMEOUT=60000

# Sabito frontend URL (optional, for opening Sabito in browser)
# VITE_SABITO_URL=http://localhost:5175

# WebSocket / Socket.IO (optional). On myapp.africanbusinesssuite.com, disabled unless set to true (Vercel API has no socket.io).
# VITE_WS_ENABLED=false  # force off (local or any host)
# VITE_WS_ENABLED=true   # force on (e.g. self-hosted API with Socket.IO)
