# Sabito Mobile App - Environment Variables Template
# Copy this file to .env.development, .env.preview, or .env.production
# and fill in your actual values

# ==================================================
# API CONFIGURATION
# ==================================================
# Backend API base URL
# Development: http://localhost:4001 or http://YOUR_LOCAL_IP:4001
# Production: https://api.sabito.com
API_URL=http://localhost:4001

# Support content URL from Sabito website
# Development: http://localhost:5174/api/support/support-content.json
# Production: https://sabito.com/api/support/support-content.json
SUPPORT_CONTENT_URL=http://localhost:5174/api/support/support-content.json

# ==================================================
# GOOGLE OAUTH
# ==================================================
# Get these from Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# ==================================================
# PAYSTACK CONFIGURATION
# ==================================================
# Get from https://dashboard.paystack.com/
# Development: Use test key (pk_test_...)
# Production: Use live key (pk_live_...)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxx

# ==================================================
# FEATURE FLAGS
# ==================================================
ENABLE_DARK_MODE=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_PUSH_NOTIFICATIONS=true

# ==================================================
# CACHE CONFIGURATION
# ==================================================
SUPPORT_CONTENT_CACHE_HOURS=24
SESSION_TIMEOUT_MINUTES=30

# ==================================================
# DEBUG SETTINGS (Development only)
# ==================================================
DEBUG_MODE=true
LOG_LEVEL=verbose

# ==================================================
# SENTRY ERROR TRACKING
# ==================================================
# Get from https://sentry.io/
# Development: Use development DSN
# Production: Use production DSN (or same DSN with different environment)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ==================================================
# NOTES
# ==================================================
# - Never commit .env files with real values
# - Use different keys for development and production
# - For EAS builds, use EAS secrets instead of .env files
# - See PRODUCTION_GUIDE.md for complete setup instructions
