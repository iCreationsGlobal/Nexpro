# Main app URL for signup/login links during local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL for pricing, auth config, and demo/contact forms.
# Local dev: demo API. Production default (when unset): https://api.africanbusinesssuite.com
NEXT_PUBLIC_API_URL=https://demo-api.africanbusinesssuite.com

# Subscription pricing UI (nav, /pricing, homepage plans). Off when unset.
# NEXT_PUBLIC_SHOW_PRICING=true

# Canonical marketing site URL (production: https://www.absghana.com).
# NEXT_PUBLIC_SITE_URL=https://www.absghana.com
# NEXT_PUBLIC_ALTERNATE_SITE_URLS=https://africanbusinesssuite.com,https://absghana.com

# ABS Online Store / Vite storefront origin for /shop/:slug redirects.
# Must be a DIFFERENT host than NEXT_PUBLIC_SITE_URL (marketing cannot serve the SPA).
# Production: https://store.absghana.com (storefront Vercel project — not marketing, not Sabito).
# NEXT_PUBLIC_ONLINE_STORE_URL=https://store.absghana.com

# --- Analytics (production only by default) ---
# Direct gtag.js loads in production. Override IDs if needed.
# For local testing: NEXT_PUBLIC_GA_ENABLED=true

# Google Analytics 4 measurement ID (ABS marketing site stream).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TJP79NHHRL
# NEXT_PUBLIC_GA_ENABLED=true

# Optional Google tag (GT- prefix) for Ads / other linked destinations.
# NEXT_PUBLIC_GOOGLE_TAG_ID=GT-WPTCCXGH

# Optional Google Tag Manager (GTM-). When set, direct gtag is skipped — add GA4 in GTM instead.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ENABLED=true
