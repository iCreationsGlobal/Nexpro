{
  "version": 2,
  "buildCommand": "npm run vercel:build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/partner-commissions/reconcile",
      "schedule": "*/2 * * * *"
    }
  ]
}
