# Backend API URL (must match Backend/.env demo DB — same as web local)
#
# Pick ONE line for your setup:
# - iOS Simulator / Android Emulator: http://localhost:5001
# - Physical device (same Wi‑Fi as Mac): run `npm run show-api-url` in mobile/ and paste the LAN IP line
# - Production / EAS builds: https://api.africanbusinesssuite.com
#
# localhost on a physical phone fails — the phone cannot reach your Mac via localhost.
# After changing: npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:5001

# Production example:
# EXPO_PUBLIC_API_URL=https://api.africanbusinesssuite.com

# ABS Online Store host (share / open / go-live links → /shop/:slug)
# EXPO_PUBLIC_ONLINE_STORE_URL=https://store.absghana.com
